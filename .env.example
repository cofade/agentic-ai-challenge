# Copy to .env and fill in only the provider you intend to use.
# See docs/09-architecture-decisions/ADR-004-llm-provider-abstraction.md.

# Provider selection (anthropic | azure).
# `azure` raises ConfigurationError today — full implementation deferred.
WSCAD_TRIAGE_PROVIDER=anthropic

# Anthropic (default provider)
ANTHROPIC_API_KEY=
WSCAD_TRIAGE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Azure OpenAI (production target — stub today)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
