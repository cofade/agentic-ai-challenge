# Copy to .env and fill in only the provider you intend to use.
# See docs/09-architecture-decisions/ADR-004-llm-provider-abstraction.md.

# Provider selection (ollama | anthropic | azure).
# - ollama (default): self-hosted, runs against a local Ollama server.
#   Run `ollama pull gpt-oss:20b` once before first use.
# - anthropic: cloud, paid. Requires ANTHROPIC_API_KEY below.
# - azure: production target; raises ConfigurationError today.
WSCAD_TRIAGE_PROVIDER=ollama

# Ollama (default provider)
WSCAD_TRIAGE_OLLAMA_BASE_URL=http://localhost:11434
WSCAD_TRIAGE_OLLAMA_MODEL=gpt-oss:20b
WSCAD_TRIAGE_OLLAMA_TIMEOUT=120

# Anthropic (cloud, paid)
ANTHROPIC_API_KEY=
WSCAD_TRIAGE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Azure OpenAI (production target — stub today)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
